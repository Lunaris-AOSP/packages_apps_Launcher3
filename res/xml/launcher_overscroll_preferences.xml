<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_overscroll_stiffness"
        android:title="@string/overscroll_stiffness_title"
        android:summary="@string/overscroll_stiffness_summary"
        android:persistent="true"
        android:max="1000"
        android:defaultValue="200"
        settings:min="50"
        settings:units=""
        launcher:iconSpaceReserved="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_overscroll_damping_ratio"
        android:title="@string/overscroll_damping_title"
        android:summary="@string/overscroll_damping_summary"
        android:persistent="true"
        android:max="100"
        android:defaultValue="50"
        settings:min="10"
        settings:units="%"
        launcher:iconSpaceReserved="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_overscroll_max_stretch"
        android:title="@string/overscroll_max_stretch_title"
        android:summary="@string/overscroll_max_stretch_summary"
        android:persistent="true"
        android:max="40"
        android:defaultValue="15"
        settings:min="5"
        settings:units="%"
        launcher:iconSpaceReserved="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_overscroll_velocity_scale"
        android:title="@string/overscroll_velocity_scale_title"
        android:summary="@string/overscroll_velocity_scale_summary"
        android:persistent="true"
        android:max="200"
        android:defaultValue="25"
        settings:min="10"
        settings:units="%"
        launcher:iconSpaceReserved="false" />

</androidx.preference.PreferenceScreen>
